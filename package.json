{
  "name": "ebala",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:main": "node scripts/build-main.mjs",
    "build:all": "pnpm build && pnpm build:main",
    "rebuild:electron": "electron-rebuild -t prod --only node-pty,ssh2",
    "dist:mac": "pnpm rebuild:electron && pnpm build:all && electron-builder --mac --arm64",
    "start": "env -u ELECTRON_RUN_AS_NODE sh -c 'vite --host 127.0.0.1 --strictPort & VITE_PID=$!; VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .; kill $VITE_PID'",
    "start:debug": "env -u ELECTRON_RUN_AS_NODE BLUETOOTH_DEBUG=1 sh -c 'vite --host 127.0.0.1 --strictPort & VITE_PID=$!; VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .; kill $VITE_PID'",
    "start:electron": "env -u ELECTRON_RUN_AS_NODE VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "lint": "eslint .",
    "preview": "vite preview",
    "rebuild": "electron-rebuild -f -w node-pty"
  },
  "build": {
    "appId": "com.ebala.controlcenter",
    "productName": "Control Center",
    "directories": { "output": "release" },
    "extends": null,
    "npmRebuild": false,
    "extraMetadata": {
      "main": "dist-electron/main.cjs",
      "type": "commonjs"
    },
    "files": ["dist/**/*", "dist-electron/**/*", "package.json"],
    "extraResources": [
      { "from": "dist-electron/swift", "to": "swift", "filter": ["**/*.swift"] }
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/ssh2/**",
      "node_modules/cpu-features/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [{ "target": "dmg", "arch": "arm64" }],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "Read battery levels from connected Bluetooth devices.",
        "NSBluetoothPeripheralUsageDescription": "Read battery levels from connected Bluetooth devices.",
        "NSAppleEventsUsageDescription": "Control playback in Spotify, Apple Music and other media apps."
      }
    },
    "dmg": { "writeUpdateInfo": false, "title": "Control Center ${version}" }
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "electron", "node-pty", "ssh2"]
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.16.0",
    "node-pty": "^1.1.0",
    "plist": "^5.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sql.js": "^1.14.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/plist": "^3.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
